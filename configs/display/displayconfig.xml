        <point><value>0.7500732493</value><nits>704.2360</nits></point>
        <point><value>0.7750756910</value><nits>757.4660</nits></point>
        <point><value>0.7999804668</value><nits>811.1230</nits></point>
        <point><value>0.8000781326</value><nits>811.5053</nits></point>
        <point><value>0.8250805743</value><nits>909.3720</nits></point>
        <point><value>0.8500830159</value><nits>1007.2388</nits></point>
