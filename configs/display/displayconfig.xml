<?xml version="1.0" encoding="UTF-8"?>
<!--
     Display device config for the AA551 panel (installed as
     vendor/etc/displayconfig/display_id_4630946607878435459.xml).

     Split of responsibilities:
     - This file owns what config.xml cannot express: the physical
       backlight-to-nits map (incl. the HBM range) and the HBM/HDR block.
     - The auto-brightness policy (lux curve, debounce, hysteresis thresholds)
       stays in overlay/OPlusFrameworksResTarget config.xml; DisplayDeviceConfig
       falls back to those resources because this file deliberately has no
       <autoBrightness>/<*ChangeThresholds>/<screenBrightnessRamp*> elements.

     The brightness map is the same 22-point sampling of the stock OOS
     display_brightness_config_P_3.xml DBV-to-nits table already used by the
     overlay arrays (backlight b in 1..255 -> value (b-1)/254), plus the knee
     at 0.8: stock level 8191/10239 = 811.12 nits is the normal-mode maximum;
     0.8..1.0 is the linear sunshine/HBM region up to 1594 nits. Any edit here
     must keep the two copies in sync.
-->
<displayConfiguration>
    <densityMapping>
        <density>
            <height>2780</height>
            <width>1264</width>
            <density>480</density>
        </density>
    </densityMapping>

    <screenBrightnessMap interpolation="linear">
        <point><value>0.0000000000</value><nits>1.9768</nits></point>
        <point><value>0.0004883289</value><nits>1.9820</nits></point>
        <point><value>0.0250024416</value><nits>2.7922</nits></point>
        <point><value>0.0500048833</value><nits>4.9882</nits></point>
        <point><value>0.0750073249</value><nits>6.7986</nits></point>
        <point><value>0.1000097666</value><nits>9.8629</nits></point>
        <point><value>0.1250122082</value><nits>14.4212</nits></point>
        <point><value>0.1500146499</value><nits>20.3859</nits></point>
        <point><value>0.1750170915</value><nits>28.2603</nits></point>
        <point><value>0.2000195332</value><nits>37.7734</nits></point>
        <point><value>0.2250219748</value><nits>48.9402</nits></point>
        <point><value>0.2500244164</value><nits>62.0613</nits></point>
        <point><value>0.2750268581</value><nits>76.9747</nits></point>
        <point><value>0.3000292997</value><nits>93.4966</nits></point>
        <point><value>0.3250317414</value><nits>111.7880</nits></point>
        <point><value>0.3500341830</value><nits>131.9260</nits></point>
        <point><value>0.3750366247</value><nits>153.4980</nits></point>
        <point><value>0.4000390663</value><nits>177.3330</nits></point>
        <point><value>0.4250415080</value><nits>202.5150</nits></point>
        <point><value>0.4500439496</value><nits>230.0510</nits></point>
        <point><value>0.4750463912</value><nits>258.6480</nits></point>
        <point><value>0.5000488329</value><nits>289.7350</nits></point>
        <point><value>0.5250512745</value><nits>321.8670</nits></point>
        <point><value>0.5500537162</value><nits>356.8880</nits></point>
        <point><value>0.5750561578</value><nits>393.4740</nits></point>
        <point><value>0.6000585995</value><nits>432.0830</nits></point>
        <point><value>0.6250610411</value><nits>471.8820</nits></point>
        <point><value>0.6500634828</value><nits>514.8370</nits></point>
